---
import * as m from "../paraglide/messages";
import { locales as availableLocales, getLocale } from "../paraglide/runtime";

const currentLang = getLocale();

// Build locale data
const localeNames: Record<string, string> = {
  en: "English",
  de: "Deutsch",
};

const locales = availableLocales.map((code) => ({
  code,
  name: localeNames[code] || code,
  path: `/${code}`,
}));

// Get current path without locale prefix
const pathname = Astro.url.pathname;
let pathWithoutLocale = pathname;
const localePattern = new RegExp(`^/(${availableLocales.join("|")})(\/|$)`);
const match = pathname.match(localePattern);
if (match) {
  pathWithoutLocale = pathname.replace(localePattern, "/");
}
if (pathWithoutLocale === "") pathWithoutLocale = "/";
---

<div class="language-switcher">
  <p class="current-lang">{m.current_language({ lang: currentLang })}</p>
  <div class="lang-buttons">
    {
      locales.map((locale) => (
        <a
          href={
            locale.path === "/"
              ? pathWithoutLocale
              : locale.path + pathWithoutLocale
          }
          class:list={["lang-button", { active: currentLang === locale.code }]}
          aria-current={currentLang === locale.code ? "page" : undefined}
        >
          {locale.name}
        </a>
      ))
    }
  </div>
</div>

<style>
  .language-switcher {
    position: fixed;
    top: 20px;
    right: 20px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    padding: 1rem;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    z-index: 1000;
  }

  .current-lang {
    margin: 0 0 0.5rem 0;
    font-size: 0.875rem;
    color: #666;
    font-weight: 500;
  }

  .lang-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .lang-button {
    padding: 0.5rem 1rem;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    background: white;
    color: #374151;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s;
    cursor: pointer;
  }

  .lang-button:hover {
    border-color: #9333ea;
    color: #9333ea;
    transform: translateY(-2px);
  }

  .lang-button.active {
    background: #9333ea;
    border-color: #9333ea;
    color: white;
    cursor: default;
  }

  .lang-button.active:hover {
    transform: none;
  }
</style>
